  if(navigator.clipboard&&navigator.clipboard.writeText){navigator.clipboard.writeText(t).then(function(){toast("Reporte copiado");},function(){toast("No se pudo copiar. Mantén presionado el texto para copiarlo.");});}
  else toast("Mantén presionado el texto para copiarlo.");};

// ---------- asistente IA ----------
var sampleFn=null,iaBusy=false,iaHist=[];
function addMsg(text,who){var d=document.createElement("div");d.className="msg "+who;d.textContent=text;$("chat").appendChild(d);d.scrollIntoView({block:"end",behavior:"auto"});return d;}
function setIANotice(t){var n=$("ia-notice");if(t){n.textContent=t;n.style.display="block";}else n.style.display="none";}
function contexto(){
  var hoy=dayKey(new Date()),r=resumen(hoy),ay=resumen(dayKey(addDays(new Date(),-1)));
  var sem=[];for(var i=6;i>=0;i--){var k=dayKey(addDays(new Date(),-i)),x=resumen(k);sem.push({dia:k,ventas_bs:Math.round(x.total),n:x.n});}
  var vend7={};S.ventas.forEach(function(v){if(new Date(v.fecha)>=addDays(new Date(),-7))v.items.forEach(function(it){vend7[it.pid]=(vend7[it.pid]||0)+it.cant;});});
  return {negocio:S.negocio.nombre,fecha_hoy:hoy,
    productos:S.productos.map(function(p){return {id:p.id,nombre:p.nombre,unidad:p.unidad,stock:p.stock,stock_minimo:p.min,costo_bs:p.costo,precio_bs:p.precio,estado:estado(p),vendidos_ult_7_dias:vend7[p.id]||0};}),
    hoy:{ventas_bs:Math.round(r.total*100)/100,ganancia_bs:Math.round(r.gan*100)/100,cantidad_ventas:r.n,mas_vendidos:r.top.slice(0,5).map(function(x){return {nombre:x.nombre,cantidad:x.cant,monto_bs:x.monto};})},
    ayer:{ventas_bs:Math.round(ay.total)},ultimos_7_dias:sem};
}
var tools=[
  {name:"registrar_venta",description:"Registra una venta y descuenta el stock. Úsala solo cuando el usuario diga que vendió productos. Usa los id de producto del contexto.",
   inputSchema:{type:"object",properties:{items:{type:"array",items:{type:"object",properties:{producto_id:{type:"string"},cantidad:{type:"integer",minimum:1}},required:["producto_id","cantidad"]}}},required:["items"]},
   execute:function(input){var r=registrarVenta((input.items||[]).map(function(x){return {pid:x.producto_id,cant:x.cantidad};}));setTimeout(function(){renderAll();},0);
     return {ok:true,total_bs:r.total,nuevas_alertas:r.alertas.map(function(p){return {nombre:p.nombre,stock:p.stock,minimo:p.min};})};}},
  {name:"registrar_compra",description:"Suma stock cuando llega mercadería. Úsala solo cuando el usuario diga que compró o le llegó un producto.",
   inputSchema:{type:"object",properties:{producto_id:{type:"string"},cantidad:{type:"integer",minimum:1}},required:["producto_id","cantidad"]},
   execute:function(input){var p=registrarCompra(input.producto_id,input.cantidad,0);setTimeout(function(){renderAll();},0);return {ok:true,producto:p.nombre,stock_nuevo:p.stock};}}
];
async function preguntar(q){
  if(iaBusy||!q.trim())return;
  if(!sampleFn){setIANotice("El asistente con IA se activa al abrir esta página dentro de Claude. En la versión final responde directamente en el WhatsApp del dueño.");return;}
  iaBusy=true;$("chat-send").disabled=true;addMsg(q,"me");var bot=addMsg("Pensando…","bot");
  var sys="Eres el asistente de inventario de "+S.negocio.nombre+", un negocio en Santa Cruz, Bolivia. Respondes en español, breve y claro, como un mensaje de WhatsApp (puedes usar *negritas* y viñetas •). Montos en bolivianos (Bs). Usa solo los datos del contexto; si algo no está, dilo. Si el usuario dice que vendió algo, usa registrar_venta; si dice que llegó o compró mercadería, usa registrar_compra. Si un nombre de producto es ambiguo, pregunta antes de registrar. Después de registrar, confirma en una línea y menciona si algún producto quedó bajo el mínimo.\n\nCONTEXTO (JSON):\n"+JSON.stringify(contexto());
  var msgs=[{role:"user",content:sys+"\n\nMENSAJE DEL DUEÑO:\n"+q}];
  if(iaHist.length){msgs=[{role:"user",content:sys+"\n\nConversación previa:\n"+iaHist.slice(-6).join("\n")+"\n\nMENSAJE DEL DUEÑO:\n"+q}];}
  try{
    var res=await sampleFn(msgs,{modelTier:"quick",cache:false,tools:tools,onText:function(ev){bot.textContent=ev.text;}});
    bot.textContent=res.text||bot.textContent;iaHist.push("Dueño: "+q,"Asistente: "+bot.textContent);setIANotice("");
  }catch(err){
    if(err&&err.code==="not_granted"){bot.remove();setIANotice("Para usar el asistente, permite que esta página use la IA de Claude cuando te lo pida.");}
    else if(err&&err.code==="rate_limited"){bot.textContent="Hay muchas consultas en este momento. Espera un minuto y vuelve a intentar.";}
    else{bot.textContent="No pude responder: "+((err&&err.message)||"error desconocido")+". Intenta de nuevo.";}
  }finally{iaBusy=false;$("chat-send").disabled=false;}
}
$("chat-form").addEventListener("submit",function(e){e.preventDefault();var v=$("chat-input").value;$("chat-input").value="";preguntar(v);});
$("chips").addEventListener("click",function(e){var c=e.target.closest(".chip");if(c)preguntar(c.textContent);});
(async function(){try{if(window.claude&&typeof window.claude.use==="function"){sampleFn=await window.claude.use("sample");}}catch(e){sampleFn=null;}})();

renderAll();
iniciarSync();
})();
</script>
