  var bs_=buckets(),max=0,sumT=0,sumG=0,sumN=0,dias=0;
  bs_.forEach(function(b){if(b.t>max)max=b.t;sumT+=b.t;sumG+=b.g;sumN+=b.n;if(b.n>0)dias++;});
  var titulos={dia:"Ventas por hora · "+(diaSel===dayKey(new Date())?"hoy":keyToDate(diaSel).toLocaleDateString("es-BO",{day:"numeric",month:"short"})),semana:"Últimos 7 días",mes:"Últimos 30 días",total:"Total por mes"};
