  openModal('<h2 id="modal-title">Cómo crear tu hoja de Google</h2><ol class="steps">'+
    '<li>Entra a <b>sheets.google.com</b> con la cuenta de Google del negocio y crea una hoja en blanco. Ponle de nombre, por ejemplo, "Inventario – Mi negocio".</li>'+
    '<li>En la hoja, abre <b>Extensiones → Apps Script</b>. Borra lo que aparece y pega el código del archivo <span class="code">Code.gs</span>. Toca <b>Guardar</b>.</li>'+
    '<li>Vuelve a la hoja y recárgala. Aparece el menú <b>Inventario IA</b>: toca <b>Preparar hoja</b>. Google te pedirá permiso la primera vez; acepta. Al terminar te muestra tu <b>clave</b>.</li>'+
    '<li>En Apps Script toca <b>Implementar → Nueva implementación</b>, tipo <b>Aplicación web</b>. En "Ejecutar como" elige <b>Yo</b> y en "Quién tiene acceso" elige <b>Cualquier usuario</b>. Toca <b>Implementar</b>.</li>'+
    '<li>Copia la <b>URL de la aplicación web</b> (termina en <span class="code">/exec</span>) y pégala aquí con tu clave. Toca <b>Conectar</b>.</li>'+
    '<li>En cada celular o computadora del negocio, abre la app y conéctala con la misma dirección y clave.</li></ol>'+
    '<p class="muted" style="margin:0">La dirección y la clave funcionan como una llave: compártelas solo con la gente del negocio.</p>'+
    '<div class="actions"><button class="btn primary" type="button" id="g-volver">Volver a Ajustes</button></div>');
  $("g-volver").onclick=modalAjustes;
}

// ---------- eventos ----------
document.querySelectorAll("nav button").forEach(function(b){b.addEventListener("click",function(){
  document.querySelectorAll("nav button").forEach(function(x){x.removeAttribute("aria-current");});b.setAttribute("aria-current","page");
  document.querySelectorAll(".view").forEach(function(v){v.classList.remove("active");});$("v-"+b.dataset.view).classList.add("active");
  document.querySelector("main").scrollTop=0;renderAll();});});
$("btn-settings").onclick=modalAjustes;
$("sync-pill").onclick=function(){if(conectado())sincronizar(true);else modalAjustes();};
$("detalle-ventas").addEventListener("click",clickVentas);
$("ventas-hoy").addEventListener("click",clickVentas);
$("periodos").addEventListener("click",function(e){var b=e.target.closest("button");if(!b)return;periodo=b.dataset.p;renderChart();});
$("chart").addEventListener("click",function(e){var b=e.target.closest("[data-day]");if(!b)return;diaSel=b.dataset.day;renderChart();renderDetalle();});
$("dia-prev").onclick=function(){diaSel=dayKey(addDays(keyToDate(diaSel),-1));renderChart();renderDetalle();};
$("dia-next").onclick=function(){var n=dayKey(addDays(keyToDate(diaSel),1));if(n<=dayKey(new Date())){diaSel=n;renderChart();renderDetalle();}};
$("buscar-venta").oninput=renderVender;
$("buscar-prod").oninput=renderProductos;
$("venta-productos").addEventListener("click",function(e){var b=e.target.closest("[data-add]");if(!b)return;var id=b.dataset.add,p=prod(id);
  if((carrito[id]||0)<p.stock){carrito[id]=(carrito[id]||0)+1;$("venta-alertas").innerHTML="";renderVender();}});
$("carrito").addEventListener("click",function(e){var b=e.target.closest("button");if(!b)return;
  if(b.dataset.inc){var p=prod(b.dataset.inc);if(carrito[p.id]<p.stock)carrito[p.id]++;}
  if(b.dataset.dec){carrito[b.dataset.dec]--;if(carrito[b.dataset.dec]<=0)delete carrito[b.dataset.dec];}
  renderVender();});
$("btn-vaciar").onclick=function(){carrito={};renderVender();};
$("btn-registrar").onclick=function(){
  try{var r=registrarVenta(Object.keys(carrito).map(function(id){return {pid:id,cant:carrito[id]};}));carrito={};renderAll();mostrarAlertasVenta(r.alertas);toast("Venta registrada: "+bs(r.total));}
  catch(err){toast(err.message);}};
