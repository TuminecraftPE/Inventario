  var cols="repeat("+bs_.length+",1fr)";$("chart").style.gridTemplateColumns=cols;$("chart-days").style.gridTemplateColumns=cols;
  var clic=periodo==="semana"||periodo==="mes";
  var maxIdx=bs_.reduce(function(m,b,i){return b.t>bs_[m].t?i:m;},0);
  $("chart").innerHTML=bs_.map(function(b,i){
    var h=max?Math.max(2,Math.round(b.t/max*100)):2,gp=b.t>0?Math.round(b.g/b.t*100):0,sel=clic&&b.key===diaSel;
    var lbl=(bs_.length<=15||sel||i===maxIdx)&&b.t>0?compacto(b.t):"";
    return '<button type="button" class="bar'+(sel?' sel':'')+'"'+(clic?' data-day="'+b.key+'"':' disabled')+' aria-label="'+esc(b.label)+': ventas '+esc(bs(b.t))+', ganancia '+esc(bs(b.g))+'"><span class="num">'+lbl+'</span><div class="col" style="height:'+h+'%"><i style="height:'+gp+'%"></i></div></button>';}).join("");
  $("chart-days").innerHTML=bs_.map(function(b){return '<div>'+(b.showLabel?esc(b.label):"")+'</div>';}).join("");
  $("chart-hint").style.display=clic?"":"none";
