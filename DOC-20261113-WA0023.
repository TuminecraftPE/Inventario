var periodo="semana", diaSel=dayKey(new Date());
function compacto(n){n=Math.round(n);return n>=1000?(Math.round(n/100)/10).toLocaleString("es-BO")+"k":String(n);}
function diaCorto(d){return new Date(d).toLocaleDateString("es-BO",{weekday:"short"}).replace(".","");}
function keyToDate(k){var a=k.split("-");return new Date(+a[0],+a[1]-1,+a[2]);}
function buckets(){
  var hoy=new Date(),out=[];
  if(periodo==="dia"){
    var vs=ventasDia(diaSel);
    for(var h=7;h<=21;h++){var t=0,g=0,n=0;vs.forEach(function(v){if(new Date(v.fecha).getHours()===h){t+=totalVenta(v);g+=ganVenta(v);n++;}});
      out.push({label:h+"h",showLabel:h%2===1,t:t,g:g,n:n});}
    return out;
  }
  if(periodo==="semana"||periodo==="mes"){
    var len=periodo==="semana"?7:30;
    for(var i=len-1;i>=0;i--){var d=addDays(hoy,-i),k=dayKey(d),r=resumen(k);
      out.push({key:k,label:i===0?"Hoy":(periodo==="semana"?diaCorto(d):String(d.getDate())),showLabel:periodo==="semana"||i===0||(len-1-i)%5===0,t:r.total,g:r.gan,n:r.n});}
    return out;
  }
  // total: por mes
  var porMes={};S.ventas.forEach(function(v){var d=new Date(v.fecha),k=d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0");
    var o=porMes[k]||(porMes[k]={t:0,g:0,n:0});o.t+=totalVenta(v);o.g+=ganVenta(v);o.n++;});
  var ks=Object.keys(porMes).sort();
  if(!ks.length)ks=[hoy.getFullYear()+"-"+String(hoy.getMonth()+1).padStart(2,"0")];
  var a=ks[0].split("-"),cur=new Date(+a[0],+a[1]-1,1),fin=new Date(hoy.getFullYear(),hoy.getMonth(),1);
  while(cur<=fin){var mk=cur.getFullYear()+"-"+String(cur.getMonth()+1).padStart(2,"0"),o=porMes[mk]||{t:0,g:0,n:0};
    out.push({label:cur.toLocaleDateString("es-BO",{month:"short"}).replace(".",""),showLabel:true,t:o.t,g:o.g,n:o.n});cur.setMonth(cur.getMonth()+1);}
  return out;
}
