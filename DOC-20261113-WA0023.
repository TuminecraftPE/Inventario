// ---------- calculadora de costo por receta ----------
var UN={
  g:{d:"peso",f:1,l:"gramos (g)"},kg:{d:"peso",f:1000,l:"kilos (kg)"},lb:{d:"peso",f:453.6,l:"libras"},
  arroba:{d:"peso",f:11340,l:"arrobas (25 lb)"},qq:{d:"peso",f:45360,l:"quintales (100 lb)"},
  ml:{d:"vol",f:1,l:"mililitros (ml)"},L:{d:"vol",f:1000,l:"litros (L)"},
  u:{d:"cant",f:1,l:"unidades"},doc:{d:"cant",f:12,l:"docenas"},maple:{d:"cant",f:30,l:"maples (30)"}
};
var UN_ORDEN=["g","kg","lb","arroba","qq","ml","L","u","doc","maple"];
function unSelect(id,val){return '<select id="'+id+'">'+UN_ORDEN.map(function(k){return '<option value="'+k+'"'+(k===val?' selected':'')+'>'+UN[k].l+'</option>';}).join("")+'</select>';}
function unCorta(k){return {g:"g",kg:"kg",lb:"lb",arroba:"arroba",qq:"quintal",ml:"ml",L:"L",u:"unid.",doc:"docena",maple:"maple"}[k]||k;}
function bsd(n,dec){return "Bs "+(Number(n)||0).toLocaleString("es-BO",{minimumFractionDigits:dec,maximumFractionDigits:dec});}
function costoIng(i){
  var a=UN[i.usaU],b=UN[i.compraU];if(!a||!b)return {err:"Elige las unidades"};
  if(a.d!==b.d)return {err:"Usas "+i.nombre+" en "+UN[i.usaU].l+" pero lo compras en "+UN[i.compraU].l+". Elige unidades del mismo tipo (peso con peso, líquido con líquido, unidades con unidades)."};
  var usa=+i.usa,comp=+i.compra,pre=+i.precio;
  if(!(comp>0))return {err:"Escribe cuánto "+i.nombre+" compraste"};
  if(!(pre>=0)||i.precio==="")return {err:"Escribe cuánto pagaste por "+i.nombre};
  return {c:(usa*a.f)/(comp*b.f)*pre};
}
function ejemploEmpanadas(){return {rinde:40,otros:10,ingredientes:[
  {nombre:"Harina",usa:1,usaU:"kg",compra:1,compraU:"arroba",precio:110},
  {nombre:"Manteca",usa:250,usaU:"g",compra:1,compraU:"kg",precio:30},
  {nombre:"Queso",usa:1,usaU:"kg",compra:1,compraU:"kg",precio:45},
  {nombre:"Huevos",usa:2,usaU:"u",compra:1,compraU:"maple",precio:30},
  {nombre:"Azúcar",usa:100,usaU:"g",compra:1,compraU:"kg",precio:8},
  {nombre:"Aceite para freír",usa:1,usaU:"L",compra:1,compraU:"L",precio:18}]};}

function wizardReceta(prodDraft,done){
  var R=prodDraft.receta?clone(prodDraft.receta):{rinde:"",otros:"",ingredientes:[{nombre:"",usa:"",usaU:"g",compra:1,compraU:"kg",precio:""}]};
  var step=1,uProd=prodDraft.unidad||"unid.",nProd=prodDraft.nombre||"tu producto",margen=50,err="";
  function stepper(){var s=["Rinde","Ingredientes","Compras","Resultado"];
    return '<ol class="stepper">'+s.map(function(t,i){return '<li class="'+(i+1===step?'cur':(i+1<step?'done':''))+'"><span>'+(i+1)+'</span>'+t+'</li>';}).join("")+'</ol>';}
  function errBox(){return err?'<div class="alertbox bad" role="alert">'+esc(err)+'</div>':'';}
  function nav(nextTxt){return '<div class="actions">'+(step>1?'<button class="btn" type="button" id="w-back">Atrás</button>':'<button class="btn" type="button" id="w-cancel">Cancelar</button>')+'<button class="btn primary" type="button" id="w-next" style="margin-left:auto">'+nextTxt+'</button></div>';}
  function calc(){var tot=0,filas=R.ingredientes.map(function(i){var r=costoIng(i);tot+=r.c||0;return {i:i,c:r.c||0};});var otros=+R.otros||0;tot+=otros;return {filas:filas,otros:otros,total:tot,unit:tot/(+R.rinde||1)};}
  function render(){
    var h='<h2 id="modal-title">Calcular costo de '+esc(nProd)+'</h2>'+stepper();
    if(step===1){
      h+='<p style="margin:0">Piensa en una tanda normal de producción. <b>¿Cuántas '+esc(uProd)+' te salen con esa receta?</b></p>'+
        '<label for="w-rinde">Cantidad que sale por tanda<input type="number" id="w-rinde" min="1" step="1" placeholder="Ej.: 40" value="'+esc(R.rinde)+'"></label>'+
        errBox()+'<button class="btn small" type="button" id="w-ej" style="align-self:flex-start">Ver un ejemplo con empanadas</button>'+nav("Siguiente");
    }else if(step===2){
      h+='<p style="margin:0"><b>¿Qué ingredientes usas en esa tanda y cuánto de cada uno?</b></p>'+
        R.ingredientes.map(function(i,k){return '<div class="ing"><input type="text" id="w-n'+k+'" placeholder="Ingrediente (ej.: harina)" value="'+esc(i.nombre)+'" aria-label="Ingrediente '+(k+1)+'">'+
          '<div class="ing-q"><input type="number" id="w-u'+k+'" min="0" step="any" placeholder="Cantidad" value="'+esc(i.usa)+'" aria-label="Cantidad usada">'+unSelect("w-uu"+k,i.usaU)+
          '<button class="btn small" type="button" data-quitar="'+k+'" aria-label="Quitar ingrediente">✕</button></div></div>';}).join("")+
        '<button class="btn small" type="button" id="w-add" style="align-self:flex-start">+ Agregar ingrediente</button>'+errBox()+nav("Siguiente");
    }else if(step===3){
      h+='<p style="margin:0"><b>Ahora cuéntame cómo compras cada ingrediente.</b> Pon lo que compras normalmente en el mercado y lo que pagas.</p>'+
        R.ingredientes.map(function(i,k){return '<div class="ing"><div class="ing-t">'+esc(i.nombre)+' <span class="muted">· usas '+esc(i.usa)+' '+unCorta(i.usaU)+'</span></div>'+
          '<div class="ing-q"><span class="muted">Compré</span><input type="number" id="w-c'+k+'" min="0" step="any" value="'+esc(i.compra)+'" aria-label="Cantidad comprada de '+esc(i.nombre)+'">'+unSelect("w-cu"+k,i.compraU)+'</div>'+
          '<div class="ing-q"><span class="muted">y pagué Bs</span><input type="number" id="w-p'+k+'" min="0" step="any" placeholder="0" value="'+esc(i.precio)+'" aria-label="Precio pagado por '+esc(i.nombre)+'"></div></div>';}).join("")+
        '<label for="w-otros">Otros gastos por tanda (gas, bolsitas, servilletas…), en Bs. Opcional.<input type="number" id="w-otros" min="0" step="any" placeholder="0" value="'+esc(R.otros)+'"></label>'+
        errBox()+nav("Calcular");
    }else{
      var c=calc(),sug=Math.ceil(c.unit*(1+margen/100)*2)/2,pa=+prodDraft.precio||0;
      h+='<div class="result"><div class="muted">Cada '+esc(uProd.replace(/s$/,""))+' te cuesta</div><div class="big num">'+bsd(c.unit,2)+'</div><div class="muted num">La tanda completa ('+esc(R.rinde)+' '+esc(uProd)+') te cuesta '+bsd(c.total,2)+'</div></div>'+
        '<div><h3>De dónde sale el costo</h3>'+c.filas.map(function(f){return '<div class="row"><div><div class="name">'+esc(f.i.nombre)+'</div><div class="meta num">'+esc(f.i.usa)+' '+unCorta(f.i.usaU)+' por tanda</div></div><div class="num" style="text-align:right">'+bsd(f.c,2)+'<div class="meta">'+bsd(f.c/(+R.rinde),3)+' c/u</div></div></div>';}).join("")+
        (c.otros?'<div class="row"><div class="name">Otros gastos</div><div class="num" style="text-align:right">'+bsd(c.otros,2)+'<div class="meta">'+bsd(c.otros/(+R.rinde),3)+' c/u</div></div></div>':'')+'</div>'+
        '<div><h3>¿A cuánto venderlo?</h3><p class="muted" style="margin:0 0 6px">Elige cuánto quieres ganar sobre tu costo:</p><div class="seg" id="w-marg">'+[30,50,100].map(function(m){return '<button type="button" data-m="'+m+'" aria-pressed="'+(m===margen)+'">+'+m+'%</button>';}).join("")+'</div>'+
        '<p style="margin:8px 0 0">Precio sugerido: <b class="num">'+bsd(sug,2)+'</b> · ganas <b class="num">'+bsd(sug-c.unit,2)+'</b> por cada una.</p>'+
        (pa>0?'<p class="muted" style="margin:4px 0 0">Con tu precio actual de '+bsd(pa,2)+(pa>c.unit?' ganas '+bsd(pa-c.unit,2)+' por unidad ('+Math.round((pa-c.unit)/pa*100)+'% de lo que cobras).':' <b style="color:var(--bad)">pierdes '+bsd(c.unit-pa,2)+' por unidad.</b>')+'</p>':'')+'</div>'+
        '<div class="actions"><button class="btn" type="button" id="w-back">Atrás</button><button class="btn" type="button" id="w-usar" style="margin-left:auto">Usar solo el costo</button><button class="btn primary" type="button" id="w-usar2">Usar costo y precio sugerido</button></div>';
    }
    openModal(h);bind();
  }
  function leer(){
    if(step===1)R.rinde=$("w-rinde").value;
    if(step===2)R.ingredientes.forEach(function(i,k){i.nombre=$("w-n"+k).value.trim();i.usa=$("w-u"+k).value;i.usaU=$("w-uu"+k).value;
      if(!i._compraTocada&&UN[i.compraU].d!==UN[i.usaU].d){i.compraU=UN[i.usaU].d==="peso"?"kg":(UN[i.usaU].d==="vol"?"L":"u");}});
    if(step===3){R.ingredientes.forEach(function(i,k){i.compra=$("w-c"+k).value;i.compraU=$("w-cu"+k).value;i.precio=$("w-p"+k).value;i._compraTocada=true;});R.otros=$("w-otros").value;}
  }
  function validar(){
    if(step===1&&!(+R.rinde>0))return "Escribe cuántas "+uProd+" te salen por tanda (un número mayor a 0).";
    if(step===2){R.ingredientes=R.ingredientes.filter(function(i){return i.nombre||i.usa;});
      if(!R.ingredientes.length){R.ingredientes=[{nombre:"",usa:"",usaU:"g",compra:1,compraU:"kg",precio:""}];return "Agrega al menos un ingrediente.";}
      for(var k=0;k<R.ingredientes.length;k++){var i=R.ingredientes[k];if(!i.nombre)return "Falta el nombre del ingrediente "+(k+1)+".";if(!(+i.usa>0))return "Escribe cuánto "+i.nombre+" usas.";}}
    if(step===3){for(var j=0;j<R.ingredientes.length;j++){var r=costoIng(R.ingredientes[j]);if(r.err)return r.err;}}
    return "";
  }
  function bind(){
    var x;
    if((x=$("w-cancel")))x.onclick=function(){done(null);};
    if((x=$("w-back")))x.onclick=function(){if(step<4)leer();err="";step--;render();};
    if((x=$("w-next")))x.onclick=function(){leer();err=validar();if(!err)step++;render();};
    if((x=$("w-ej")))x.onclick=function(){R=ejemploEmpanadas();err="";render();toast("Ejemplo cargado. Los precios son de muestra: pon los tuyos.");};
    if((x=$("w-add")))x.onclick=function(){leer();R.ingredientes.push({nombre:"",usa:"",usaU:"g",compra:1,compraU:"kg",precio:""});render();var k=R.ingredientes.length-1;$("w-n"+k).focus();};
    $("modal").querySelectorAll("[data-quitar]").forEach(function(b){b.onclick=function(){leer();R.ingredientes.splice(+b.dataset.quitar,1);if(!R.ingredientes.length)R.ingredientes.push({nombre:"",usa:"",usaU:"g",compra:1,compraU:"kg",precio:""});render();};});
    if((x=$("w-marg")))x.onclick=function(e){var b=e.target.closest("[data-m]");if(b){margen=+b.dataset.m;render();}};
    function fin(conPrecio){var c=calc();var rec=clone(R);rec.ingredientes.forEach(function(i){delete i._compraTocada;});
      done({costo:Math.round(c.unit*100)/100,precio:conPrecio?Math.ceil(c.unit*(1+margen/100)*2)/2:0,receta:rec});}
    if((x=$("w-usar")))x.onclick=function(){fin(false);};
    if((x=$("w-usar2")))x.onclick=function(){fin(true);};
  }
  render();
}
