    $("fa-guia").onclick=modalGuia;
    $("fa-reset").onclick=function(){$("fa-reset").outerHTML='<button class="btn danger" type="button" id="fa-reset2">Sí, borrar y restablecer</button>';
      $("fa-reset2").onclick=function(){S=seed();carrito={};save();closeModal();renderAll();toast("Datos de ejemplo restablecidos");};};
    $("fa-con").onclick=async function(){
      var url=$("fa-url").value.trim(),clave=$("fa-clave").value.trim(),msg=$("fa-msg");
      if(!/^https:\/\/script\.google\.com\/.+\/exec/.test(url)){msg.innerHTML='<div class="alertbox bad">La dirección debe empezar con https://script.google.com/ y terminar en /exec.</div>';return;}
      if(!clave){msg.innerHTML='<div class="alertbox bad">Escribe la clave que te mostró la hoja.</div>';return;}
      msg.innerHTML='<p class="muted">Conectando…</p>';$("fa-con").disabled=true;
      var antes=CFG;CFG={url:url,clave:clave};
      try{
        var r=await llamar("GET"),e=r.estado,vacia=!e.productos.length&&!e.ventas.length;
        if(vacia){
          msg.innerHTML='<div class="alertbox">Tu hoja está vacía. ¿Qué quieres hacer?<div class="actions"><button class="btn primary small" type="button" id="fa-subir">Subir lo que tengo en este dispositivo</button><button class="btn small" type="button" id="fa-cero">Empezar desde cero</button></div></div>';
          $("fa-subir").onclick=function(){escribirLS(CFGKEY,CFG);encolar({op:"importar",estado:clone(S)});closeModal();pintarSync();toast("Subiendo tus datos a la hoja…");iniciarSync();};
          $("fa-cero").onclick=function(){escribirLS(CFGKEY,CFG);aplicarEstado({negocio:{nombre:S.negocio.nombre,whatsapp:S.negocio.whatsapp},productos:[],ventas:[]});encolar({op:"negocio",negocio:clone(S.negocio)});closeModal();toast("Conectado. Empieza agregando tus productos.");iniciarSync();};
        }else{
          escribirLS(CFGKEY,CFG);aplicarEstado(e);closeModal();toast("Conectado. Se cargaron los datos de tu hoja.");iniciarSync();
        }
      }catch(err){
        CFG=antes;$("fa-con").disabled=false;
        msg.innerHTML='<div class="alertbox bad">'+(err.clave?'La clave no coincide. En tu hoja usa el menú Inventario IA → Ver mi clave.':'No se pudo conectar. Revisa la dirección y tu internet. Si en la implementación no elegiste "Cualquier usuario", la app no puede entrar. (Dentro de Claude esta conexión no funciona; usa la app publicada en tu sitio.)')+'</div>';
      }
    };
  }
}
