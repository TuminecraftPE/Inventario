<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Inventario IA para negocios</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<style>
/* Layout: app de una pantalla, encabezado arriba, contenido desplazable, barra de pestañas abajo (pensado para celular) */
:root{
  --bg:#f3f6f7;
  --surface:#ffffff;
  --ink:#16252b;
  --muted:#5b6d74;
  --line:#dbe3e6;
  --accent:#0d6e7a;
  --accent-ink:#ffffff;
  --accent-soft:#e1f1f3;
  --ok:#1f7a45; --ok-soft:#e3f4ea;
  --warn:#9a5b00; --warn-soft:#fdf0d9;
  --bad:#b3261e; --bad-soft:#fbe4e2;
  --font-display:"Bricolage Grotesque", "Segoe UI", system-ui, sans-serif;
  --font-body:"IBM Plex Sans", "Segoe UI", system-ui, -apple-system, sans-serif;
  color-scheme: light;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#0e1719; --surface:#152225; --ink:#e6eef0; --muted:#97aab0; --line:#26383d;
    --accent:#3fb3c2; --accent-ink:#06282d; --accent-soft:#163a40;
    --ok:#5fcf8b; --ok-soft:#173326; --warn:#f0b450; --warn-soft:#3a2c12; --bad:#f2877f; --bad-soft:#3d1c1a;
    color-scheme: dark;
  }
}
:root[data-theme="dark"]{
  --bg:#0e1719; --surface:#152225; --ink:#e6eef0; --muted:#97aab0; --line:#26383d;
  --accent:#3fb3c2; --accent-ink:#06282d; --accent-soft:#163a40;
  --ok:#5fcf8b; --ok-soft:#173326; --warn:#f0b450; --warn-soft:#3a2c12; --bad:#f2877f; --bad-soft:#3d1c1a;
  color-scheme: dark;
}
*{box-sizing:border-box}
html,body{height:100%;margin:0}
body{background:var(--bg);color:var(--ink);font:15px/1.5 var(--font-body);display:flex;flex-direction:column}
h1,h2,h3{font-family:var(--font-display);text-wrap:balance;margin:0;line-height:1.2}
h1{font-size:19px} h2{font-size:17px} h3{font-size:15px}
button,input,select,textarea{font:inherit;color:inherit}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.num{font-variant-numeric:tabular-nums}
header{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:12px 16px;background:var(--surface);border-bottom:1px solid var(--line)}
header .sub{font-size:12px;color:var(--muted)}
.icon-btn{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:6px 10px;cursor:pointer;font-size:13px}
main{flex:1;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:16px;max-width:760px;width:100%;margin:0 auto}
nav{display:grid;grid-template-columns:repeat(5,1fr);background:var(--surface);border-top:1px solid var(--line)}
nav button{border:0;background:none;padding:10px 4px 12px;font-size:12px;color:var(--muted);cursor:pointer;display:flex;flex-direction:column;align-items:center;gap:2px}
nav button svg{width:22px;height:22px}
nav button[aria-current="page"]{color:var(--accent);font-weight:600}
.view{display:none;flex-direction:column;gap:16px}
.view.active{display:flex}
.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px;display:flex;flex-direction:column;gap:10px}
.tiles{display:grid;grid-template-columns:repeat(2,1fr);gap:10px}
.tile{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:12px}
.tile .lbl{font-size:12px;color:var(--muted)}
.tile .val{font-family:var(--font-display);font-size:22px;font-weight:700}
.tile .delta{font-size:12px}
.up{color:var(--ok)} .down{color:var(--bad)}
.pill{display:inline-block;font-size:11px;font-weight:600;padding:2px 8px;border-radius:999px;white-space:nowrap}
.pill.ok{background:var(--ok-soft);color:var(--ok)}
.pill.bajo{background:var(--warn-soft);color:var(--warn)}
.pill.agotado{background:var(--bad-soft);color:var(--bad)}
.row{display:flex;align-items:center;justify-content:space-between;gap:10px;padding:10px 0;border-top:1px solid var(--line)}
.row:first-of-type{border-top:0}
.row .name{font-weight:500}
.row .meta{font-size:12px;color:var(--muted)}
.stripe{border-left:4px solid var(--line);padding-left:10px}
.stripe.bajo{border-color:var(--warn)} .stripe.agotado{border-color:var(--bad)}
.btn{border:1px solid var(--line);background:var(--surface);border-radius:10px;padding:9px 14px;cursor:pointer;font-weight:500;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;gap:6px}
.btn.primary{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}
.btn.wa{background:#1f8f4e;border-color:#1f8f4e;color:#fff}
.btn.small{padding:5px 10px;font-size:13px}
.btn:disabled{opacity:.45;cursor:not-allowed}
.btn.danger{background:var(--bad);border-color:var(--bad);color:#fff}
.ventas-list{max-height:320px;overflow-y:auto}
.sync{border:1px solid var(--line);background:var(--bg);border-radius:999px;padding:4px 10px;font-size:12px;color:var(--muted);cursor:pointer;white-space:nowrap}
.sync::before{content:"";display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--muted);margin-right:6px;vertical-align:0}
.sync.ok::before{background:var(--ok)}.sync.busy::before{background:var(--accent)}.sync.off::before{background:var(--warn)}.sync.err::before{background:var(--bad)}
.steps{margin:0;padding-left:20px;display:flex;flex-direction:column;gap:6px;font-size:14px}
.code{font-family:ui-monospace,Menlo,monospace;font-size:12px;background:var(--bg);border:1px solid var(--line);border-radius:6px;padding:1px 5px}
.stepper{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:4px;font-size:11px;color:var(--muted)}
.stepper li{display:flex;flex-direction:column;align-items:center;gap:3px;text-align:center}
.stepper span{width:24px;height:24px;border-radius:50%;border:1px solid var(--line);display:grid;place-items:center;font-weight:600;background:var(--surface)}
.stepper li.cur{color:var(--ink);font-weight:600}.stepper li.cur span{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.stepper li.done span{background:var(--accent-soft);border-color:var(--accent);color:var(--accent)}
.ing{display:flex;flex-direction:column;gap:6px;padding:10px;border:1px solid var(--line);border-radius:12px;background:var(--bg)}
.ing-q{display:flex;gap:6px;align-items:center}.ing-q input{flex:1;min-width:0}.ing-q select{flex:1.3;min-width:0}
.ing-t{font-weight:600}
.cost-help{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:6px}
.result{background:var(--accent-soft);border-radius:14px;padding:14px;text-align:center}
.result .big{font-family:var(--font-display);font-size:34px;font-weight:700;color:var(--accent)}

.actions{display:flex;flex-wrap:wrap;gap:8px}
.chart{display:grid;gap:4px;align-items:end;height:170px;padding-top:18px;border-bottom:1px solid var(--line);background:repeating-linear-gradient(to top,transparent 0 37px,var(--line) 37px 38px)}
.bar{display:flex;flex-direction:column;align-items:center;justify-content:flex-end;height:100%;gap:2px;border:0;background:none;padding:0;cursor:pointer;min-width:0}
.bar span{font-size:10px;color:var(--muted);white-space:nowrap}
.bar .col{width:78%;max-width:34px;background:var(--accent-soft);border-radius:5px 5px 0 0;min-height:2px;display:flex;align-items:flex-end;overflow:hidden}
.bar .col i{display:block;width:100%;background:var(--accent)}
.bar.sel .col{outline:2px solid var(--ink);outline-offset:1px}
.bar.sel span{color:var(--ink);font-weight:600}
.bar[disabled]{cursor:default}
.days{display:grid;gap:4px;text-align:center;font-size:11px;color:var(--muted)}
.days div{white-space:nowrap;overflow:visible}
.seg{display:inline-flex;border:1px solid var(--line);border-radius:10px;overflow:hidden}
.seg button{border:0;background:var(--surface);padding:6px 11px;font-size:13px;cursor:pointer;color:var(--muted)}
.seg button+button{border-left:1px solid var(--line)}
.seg button[aria-pressed="true"]{background:var(--accent);color:var(--accent-ink);font-weight:600}
.sumrow{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:14px}
.sumrow b{font-family:var(--font-display);font-size:17px}
.legend{display:flex;flex-wrap:wrap;gap:6px 14px;font-size:12px;align-items:center}
.sw{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}
.sw.v{background:var(--accent-soft);border:1px solid var(--accent)}
.sw.g{background:var(--accent)}
.grid-products{display:grid;grid-template-columns:repeat(auto-fill,minmax(140px,1fr));gap:8px}
.pbtn{border:1px solid var(--line);background:var(--surface);border-radius:12px;padding:10px;text-align:left;cursor:pointer;display:flex;flex-direction:column;gap:4px}
.pbtn:hover{border-color:var(--accent)}
.pbtn:disabled{opacity:.5;cursor:not-allowed}
.pbtn .price{font-weight:600}
.qty{display:flex;align-items:center;gap:6px}
.qty button{width:30px;height:30px;border-radius:8px;border:1px solid var(--line);background:var(--surface);cursor:pointer}
.total{display:flex;justify-content:space-between;font-family:var(--font-display);font-size:20px;font-weight:700}
input[type=text],input[type=number],input[type=tel],select,textarea{width:100%;padding:9px 11px;border:1px solid var(--line);border-radius:10px;background:var(--bg)}
label{font-size:13px;color:var(--muted);display:flex;flex-direction:column;gap:4px}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.form-grid .full{grid-column:1/-1}
.report{white-space:pre-wrap;background:var(--bg);border:1px solid var(--line);border-radius:12px;padding:12px;font-size:14px}
.notice{background:var(--accent-soft);border-radius:12px;padding:10px 12px;font-size:13px}
.alertbox{background:var(--warn-soft);border:1px solid var(--warn);border-radius:12px;padding:12px;display:flex;flex-direction:column;gap:8px}
.alertbox.bad{background:var(--bad-soft);border-color:var(--bad)}
.chat{display:flex;flex-direction:column;gap:8px}
.msg{max-width:88%;padding:9px 12px;border-radius:14px;white-space:pre-wrap;font-size:14px}
.msg.me{align-self:flex-end;background:var(--accent);color:var(--accent-ink);border-bottom-right-radius:4px}
.msg.bot{align-self:flex-start;background:var(--bg);border:1px solid var(--line);border-bottom-left-radius:4px}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chip{border:1px solid var(--line);background:var(--surface);border-radius:999px;padding:5px 11px;font-size:13px;cursor:pointer}
.modal-back{position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;align-items:flex-end;justify-content:center;z-index:10}
.modal-back.open{display:flex}
.modal{background:var(--surface);width:100%;max-width:560px;border-radius:16px 16px 0 0;padding:16px;display:flex;flex-direction:column;gap:12px;max-height:90%;overflow-y:auto}
.toast{position:fixed;left:50%;bottom:84px;transform:translateX(-50%);background:var(--ink);color:var(--bg);padding:9px 14px;border-radius:10px;font-size:14px;display:none;z-index:20;max-width:90%}
.toast.show{display:block}
.muted{color:var(--muted);font-size:13px}
.empty{color:var(--muted);font-size:14px;padding:6px 0}
@media (min-width:600px){.tiles{grid-template-columns:repeat(4,1fr)}}
@media (prefers-reduced-motion:no-preference){.btn,.pbtn,.chip{transition:border-color .15s,background .15s}}
</style>
</head>
<body>
<header>
  <div>
    <h1 id="biz-name">Mi negocio</h1>
    <div class="sub" id="today-label">Hoy</div>
  </div>
  <div style="display:flex;align-items:center;gap:8px"><button class="sync" id="sync-pill" type="button" title="Estado de guardado">Solo en este celular</button><button class="icon-btn" id="btn-settings" type="button">Ajustes</button></div>
</header>

<main>
  <!-- INICIO -->
  <section class="view active" id="v-inicio" aria-label="Inicio">
    <div class="tiles">
      <div class="tile"><div class="lbl">Ventas de hoy</div><div class="val num" id="t-ventas">Bs 0</div><div class="delta num" id="t-delta"></div></div>
      <div class="tile"><div class="lbl">Ganancia estimada</div><div class="val num" id="t-ganancia">Bs 0</div><div class="delta muted" id="t-margen"></div></div>
      <div class="tile"><div class="lbl">Ventas registradas</div><div class="val num" id="t-n">0</div><div class="delta muted">hoy</div></div>
      <div class="tile"><div class="lbl">Productos por reponer</div><div class="val num" id="t-alertas">0</div><div class="delta muted" id="t-alertas-sub"></div></div>
    </div>

    <div class="card">
      <h2>Para reponer</h2>
      <div id="alert-list"></div>
      <div class="actions"><a class="btn wa small" id="wa-alertas" href="#" target="_blank" rel="noopener">Enviar lista por WhatsApp</a></div>
    </div>

    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap">
        <h2 id="chart-title">Ventas y ganancia</h2>
        <div class="seg" role="tablist" aria-label="Periodo" id="periodos">
          <button type="button" data-p="dia">Día</button>
          <button type="button" data-p="semana" aria-pressed="true">Semana</button>
          <button type="button" data-p="mes">Mes</button>
          <button type="button" data-p="total">Total</button>
        </div>
      </div>
      <div class="sumrow" id="chart-sum"></div>
      <div class="chart" id="chart"></div>
      <div class="days" id="chart-days"></div>
      <div class="legend"><span><i class="sw v"></i>Ventas</span><span><i class="sw g"></i>Ganancia</span><span class="muted" id="chart-hint">Toca una barra para ver ese día</span></div>
    </div>

    <div class="card" id="detalle-card">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
        <button class="btn small" type="button" id="dia-prev" aria-label="Día anterior">‹</button>
        <h2 id="detalle-titulo" style="text-align:center">Hoy</h2>
        <button class="btn small" type="button" id="dia-next" aria-label="Día siguiente">›</button>
      </div>
      <div class="tiles" id="detalle-tiles"></div>
      <div id="detalle-top"></div>
      <h3>Ventas registradas</h3>
      <div id="detalle-ventas" class="ventas-list"></div>
    </div>

    <div class="card">
      <h2>Lo más vendido hoy</h2>
      <div id="top-list"></div>
    </div>
  </section>

  <!-- VENDER -->
  <section class="view" id="v-vender" aria-label="Vender">
    <div class="card">
      <h2>Nueva venta</h2>
      <input type="text" id="buscar-venta" placeholder="Buscar producto…" aria-label="Buscar producto">
      <div class="grid-products" id="venta-productos"></div>
    </div>
    <div class="card">
      <h2>Detalle de la venta</h2>
      <div id="carrito"></div>
      <div class="total"><span>Total</span><span class="num" id="carrito-total">Bs 0</span></div>
      <div class="actions">
        <button class="btn primary" id="btn-registrar" type="button" disabled>Registrar venta</button>
        <button class="btn" id="btn-vaciar" type="button">Vaciar</button>
      </div>
    </div>
    <div id="venta-alertas"></div>
    <div class="card">
      <h2>Ventas de hoy</h2>
      <p class="muted" style="margin:0">Si te equivocaste, borra la venta: el stock vuelve al inventario.</p>
      <div id="ventas-hoy" class="ventas-list"></div>
    </div>
  </section>

  <!-- PRODUCTOS -->
  <section class="view" id="v-productos" aria-label="Productos">
    <div class="card">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:8px">
        <h2>Inventario</h2>
        <button class="btn primary small" id="btn-nuevo" type="button">Agregar producto</button>
      </div>
      <input type="text" id="buscar-prod" placeholder="Buscar en inventario…" aria-label="Buscar en inventario">
      <div class="muted" id="inv-resumen"></div>
      <div id="prod-list"></div>
    </div>
  </section>

  <!-- REPORTE -->
  <section class="view" id="v-reporte" aria-label="Reporte diario">
    <div class="card">
      <h2>Reporte diario</h2>
      <p class="muted" style="margin:0">Este es el mensaje que le llega al dueño cada noche. En esta demo lo envías tú con un toque; en la versión final sale solo a la hora que elijas.</p>
      <div class="report" id="report-text"></div>
      <div class="actions">
        <a class="btn wa" id="wa-reporte" href="#" target="_blank" rel="noopener">Enviar por WhatsApp</a>
        <button class="btn" id="btn-copiar" type="button">Copiar texto</button>
      </div>
    </div>
  </section>

  <!-- ASISTENTE -->
  <section class="view" id="v-asistente" aria-label="Asistente IA">
    <div class="card">
      <h2>Asistente IA</h2>
      <p class="muted" style="margin:0">Escríbele como le escribirías por WhatsApp. Puede responder preguntas sobre tu inventario y registrar ventas o compras.</p>
      <div class="chips" id="chips">
        <button class="chip" type="button">¿Qué tengo que reponer esta semana?</button>
        <button class="chip" type="button">¿Cuánto vendí hoy y qué fue lo que más salió?</button>
        <button class="chip" type="button">Vendí 2 martillos y 5 focos LED</button>
        <button class="chip" type="button">Llegaron 20 kg de clavos</button>
      </div>
      <div class="chat" id="chat">
        <div class="msg bot">Hola, soy tu asistente de inventario. Pregúntame lo que necesites.</div>
      </div>
      <div class="notice" id="ia-notice" style="display:none"></div>
      <form id="chat-form" class="actions" style="flex-wrap:nowrap">
        <input type="text" id="chat-input" placeholder="Escribe un mensaje…" aria-label="Mensaje para el asistente" autocomplete="off">
        <button class="btn primary" type="submit" id="chat-send">Enviar</button>
      </form>
    </div>
  </section>
</main>

<nav aria-label="Secciones">
  <button type="button" data-view="inicio" aria-current="page"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/></svg>Inicio</button>
  <button type="button" data-view="vender"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 4h2l2.4 11.2a1 1 0 0 0 1 .8h9.2a1 1 0 0 0 1-.8L20 8H6"/><circle cx="9" cy="20" r="1.4"/><circle cx="17" cy="20" r="1.4"/></svg>Vender</button>
  <button type="button" data-view="productos"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 8l-9-5-9 5 9 5 9-5zM3 8v8l9 5 9-5V8M12 13v8"/></svg>Inventario</button>
  <button type="button" data-view="reporte"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M6 3h9l4 4v14H6zM14 3v5h5M9 13h7M9 17h7M9 9h3"/></svg>Reporte</button>
  <button type="button" data-view="asistente"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M4 5h16v11H9l-5 4z"/><path d="M8 10h.01M12 10h.01M16 10h.01"/></svg>Asistente</button>
</nav>

<!-- Modal genérico -->
<div class="modal-back" id="modal-back">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" id="modal"></div>
</div>
<div class="toast" id="toast" role="status"></div>

<script>
(function(){
"use strict";
var SKEY = "inventario-ia-demo-v2", OLDKEY = "inventario-ia-demo-v1";

// ---------- utilidades ----------
function esc(s){return String(s).replace(/[&<>"']/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;","'":"&#39;"}[c];});}
function bs(n){return "Bs " + (Math.round(n*100)/100).toLocaleString("es-BO",{minimumFractionDigits:0,maximumFractionDigits:2});}
function dayKey(d){d=new Date(d);return d.getFullYear()+"-"+String(d.getMonth()+1).padStart(2,"0")+"-"+String(d.getDate()).padStart(2,"0");}
function addDays(d,n){var x=new Date(d);x.setDate(x.getDate()+n);return x;}
function uid(){return Math.random().toString(36).slice(2,9);}
function $(id){return document.getElementById(id);}
function toast(msg){var t=$("toast");t.textContent=msg;t.classList.add("show");clearTimeout(toast._t);toast._t=setTimeout(function(){t.classList.remove("show");},2600);}

// ---------- datos de ejemplo ----------
function seed(){
  var productos=[
    {id:"p1",nombre:"Cemento bolsa 50 kg",unidad:"bolsa",stock:40,min:15,costo:58,precio:68},
    {id:"p2",nombre:"Fierro corrugado 3/8\"",unidad:"barra",stock:120,min:50,costo:38,precio:46},
    {id:"p3",nombre:"Clavos 2\"",unidad:"kg",stock:8,min:10,costo:14,precio:20},
    {id:"p4",nombre:"Pintura látex blanca 4 L",unidad:"balde",stock:12,min:6,costo:95,precio:130},
