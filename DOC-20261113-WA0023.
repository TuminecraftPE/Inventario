// ---------- cálculos ----------
function prod(id){return S.productos.find(function(p){return p.id===id;});}
function estado(p){return p.stock<=0?"agotado":(p.stock<=p.min?"bajo":"ok");}
function estadoTxt(e){return e==="agotado"?"Agotado":(e==="bajo"?"Stock bajo":"OK");}
function sugerido(p){return Math.max(p.min*2-p.stock,p.min);}
function totalVenta(v){return v.items.reduce(function(a,it){return a+it.cant*it.precio;},0);}
function ganVenta(v){return v.items.reduce(function(a,it){return a+it.cant*(it.precio-it.costo);},0);}
function ventasDia(key){return S.ventas.filter(function(v){return dayKey(v.fecha)===key;});}
function resumen(key){
  var vs=ventasDia(key),total=0,gan=0,porProd={};
  vs.forEach(function(v){total+=totalVenta(v);gan+=ganVenta(v);v.items.forEach(function(it){
    var o=porProd[it.pid]||(porProd[it.pid]={pid:it.pid,nombre:it.nombre,cant:0,monto:0});o.cant+=it.cant;o.monto+=it.cant*it.precio;});});
  var top=Object.keys(porProd).map(function(k){return porProd[k];}).sort(function(a,b){return b.monto-a.monto;});
  return {n:vs.length,total:total,gan:gan,top:top};
}
function alertas(){return S.productos.filter(function(p){return estado(p)!=="ok";}).sort(function(a,b){return (a.stock/a.min)-(b.stock/b.min);});}
function waLink(text){var num=(S.negocio.whatsapp||"").replace(/\D/g,"");return "https://wa.me/"+num+"?text="+encodeURIComponent(text);}
function fechaLarga(d){return new Date(d).toLocaleDateString("es-BO",{weekday:"long",day:"numeric",month:"long"});}

