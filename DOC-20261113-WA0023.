// ---------- acciones de negocio ----------
function registrarVenta(lista){ // lista: [{pid,cant}]
  var items=[];
  lista.forEach(function(x){var p=prod(x.pid);if(!p)throw new Error("Producto no encontrado: "+x.pid);
    var c=Math.floor(Number(x.cant));if(!(c>0))throw new Error("Cantidad inválida para "+p.nombre);
    if(c>p.stock)throw new Error("No hay stock suficiente de "+p.nombre+" (quedan "+p.stock+")");
    items.push({pid:p.id,nombre:p.nombre,cant:c,precio:p.precio,costo:p.costo});});
  var antes={};items.forEach(function(it){antes[it.pid]=estado(prod(it.pid));});
  items.forEach(function(it){prod(it.pid).stock-=it.cant;});
  var v={id:uid(),fecha:new Date().toISOString(),items:items};S.ventas.push(v);save();encolar({op:"venta",venta:clone(v)});
  var nuevas=items.map(function(it){return prod(it.pid);}).filter(function(p){return estado(p)!=="ok"&&antes[p.id]!==estado(p);});
  return {venta:v,total:totalVenta(v),alertas:nuevas};
}
function registrarCompra(pid,cant,costo){
  var p=prod(pid);if(!p)throw new Error("Producto no encontrado");var c=Math.floor(Number(cant));if(!(c>0))throw new Error("Cantidad inválida");
  p.stock+=c;if(costo>0)p.costo=Number(costo);save();encolar({op:"compra",pid:p.id,cant:c,costo:Number(costo)||0});return p;
}
