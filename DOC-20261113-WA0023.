var CFGKEY="inventario-ia-conexion",COLAKEY="inventario-ia-pendientes";
function leerLS(k,def){try{var r=window.localStorage.getItem(k);return r?JSON.parse(r):def;}catch(e){return def;}}
function escribirLS(k,v){try{window.localStorage.setItem(k,JSON.stringify(v));}catch(e){}}
var CFG=leerLS(CFGKEY,{url:"",clave:""}),cola=leerLS(COLAKEY,[]),syncing=false,syncTimer=null,ultimoError="";
function conectado(){return !!(CFG.url&&CFG.clave);}
function encolar(op){if(!conectado())return;op.opId=uid()+Date.now().toString(36);cola.push(op);escribirLS(COLAKEY,cola);pintarSync();clearTimeout(syncTimer);syncTimer=setTimeout(sincronizar,400);}
function pintarSync(estado){
  var el=$("sync-pill");if(!el)return;
  if(!conectado()){el.className="sync";el.textContent="Solo en este celular";return;}
  if(estado==="busy"){el.className="sync busy";el.textContent="Guardando…";return;}
  if(estado==="err"){el.className="sync err";el.textContent=ultimoError==="clave"?"Clave incorrecta":(cola.length?"Sin conexión · "+cola.length+" pendiente"+(cola.length>1?"s":""):"Sin conexión");return;}
  if(cola.length){el.className="sync off";el.textContent=cola.length+" pendiente"+(cola.length>1?"s":"");return;}
  el.className="sync ok";el.textContent="Guardado en Google";
}
function llamar(metodo,datos){
  var url=CFG.url.trim();
  var req=metodo==="GET"
    ? fetch(url+(url.indexOf("?")>=0?"&":"?")+"accion=estado&clave="+encodeURIComponent(CFG.clave)+"&t="+Date.now(),{redirect:"follow"})
    : fetch(url,{method:"POST",body:JSON.stringify(Object.assign({clave:CFG.clave},datos)),redirect:"follow"});
  return req.then(function(r){if(!r.ok)throw new Error("La hoja respondió con error "+r.status);return r.json();})
    .then(function(j){if(!j||!j.ok){var m=(j&&j.error)||"respuesta inválida";var e=new Error(m);e.clave=m==="clave";throw e;}return j;});
}
function aplicarEstado(e){
  if(!e)return;S.productos=e.productos||[];S.ventas=e.ventas||[];
  S.negocio={nombre:(e.negocio&&e.negocio.nombre)||S.negocio.nombre,whatsapp:(e.negocio&&e.negocio.whatsapp)||""};
  save();renderAll();
}
async function sincronizar(manual){
  if(!conectado()||syncing)return;
  syncing=true;pintarSync("busy");
  try{
    var res;
    while(cola.length){
      var lote=cola.slice(0,40);
      res=await llamar("POST",{ops:lote});
      cola=cola.slice(lote.length);escribirLS(COLAKEY,cola);
      if(res.errores&&res.errores.length)toast("La hoja no aceptó un cambio: "+res.errores[0]);
    }
    if(!res)res=await llamar("GET");
    if(!cola.length)aplicarEstado(res.estado);
    ultimoError="";pintarSync();if(manual)toast("Datos al día con tu hoja de Google");
  }catch(err){
    ultimoError=err.clave?"clave":(err.message||"");pintarSync("err");
    if(manual)toast(err.clave?"La clave no coincide con la de tu hoja.":"No se pudo conectar con la hoja. Se guardará cuando vuelva internet.");
  }finally{syncing=false;}
}
function iniciarSync(){
  pintarSync();if(!conectado())return;
  sincronizar();
  document.addEventListener("visibilitychange",function(){if(document.visibilityState==="visible")sincronizar();});
  window.addEventListener("online",function(){sincronizar();});
  setInterval(function(){if(document.visibilityState==="visible")sincronizar();},60000);
}

